{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-bolsa-ai",
  "main": "src/index-paper-capital.ts",
  "compatibility_date": "2026-07-31",
  "vars": {
    "TRADING_MODE": "paper",
    "PAIR": "PAXGEUR",
    "INITIAL_CASH_EUR": "100"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOT_STATE", "class_name": "BotState" },
      { "name": "RESEARCH_LAB", "class_name": "ResearchLabState" },
      { "name": "LIVE_EXECUTOR", "class_name": "LiveExecutorState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BotState"] },
    { "tag": "v2", "new_sqlite_classes": ["ResearchLabState"] },
    { "tag": "v3", "new_sqlite_classes": ["LiveExecutorState"] }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
