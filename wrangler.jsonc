{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-bolsa-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "vars": {
    "TRADING_MODE": "paper",
    "PAIR": "XBTEUR",
    "INITIAL_CASH_EUR": "50"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
